        "operator-write",
        "normative-lifecycle",
        "normative-operator",
        "normative-observation"
      ],
      "assessment": "The legacy nonce is updated only by selected operations and begins at its storage default; it is not the version starting at one and incrementing once for every atomic record/management mutation. No read projection can impose expected-version authorization on direct writes.",
      "required_evidence": [
        {
          "id": "atomic-expected-version",
          "status": "EVIDENCE_REQUIRED",
          "requirement": "Enforce the exact previous canonical version at the authenticated write serialization point; simultaneous commands cannot both commit."
        },
        {
          "id": "all-mutation-version",
          "status": "EVIDENCE_REQUIRED",
          "requirement": "Start at one and increment exactly once for every successful key/service/lifecycle/operator mutation; reject overflow and preserve complete old/new state on failure."
        },
        {
          "id": "durable-monotonic-history",
          "status": "EVIDENCE_REQUIRED",
          "requirement": "Recover record/grants/history/tombstones together; detect uncertain outcomes and finalized rollback without inventing versions from time or block height."
