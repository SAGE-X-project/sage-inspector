    {"id": "wrong-public-source", "write": "create", "publisher_source": "other-origin", "publisher_did": "expected", "now": 101, "expected_version": null, "expected": "RECORD_UNREACHABLE"},
    {"id": "wrong-public-did", "write": "create", "publisher_source": "https://agents.example.com", "publisher_did": "other", "now": 101, "expected_version": null, "expected": "RECORD_UNREACHABLE"},
    {"id": "missing-committed-journal", "write": "none", "publisher_source": "https://agents.example.com", "publisher_did": "expected", "now": 101, "expected_version": null, "expected": "RECORD_UNREACHABLE"}
