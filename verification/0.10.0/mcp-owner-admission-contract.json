{
  "schema_version": 1,
  "protocol_version": "0.10.0",
  "kind": "mcp-owner-admission-contract",
  "conformance": "NOT_ESTABLISHED",
  "boundaries": [
    {
      "id": "durable-admission",
      "contract": "Persist EXECUTING before queue admission and any effect. A failed or uncertain fence cannot dispatch, while owner closure after committed admission cannot roll the admission back."
    },
    {
      "id": "close-linearization",
      "contract": "Owner closure becomes visible without waiting for registry, storage, signer, transport or tool callbacks. Final admission and publication recheck the owner under coordination."
    },
    {
      "id": "owner-isolation",
      "contract": "Authenticated request identity history remains bound to its owner, while shared gate capacity and retirement do not transfer authority or close an unrelated owner."
    },
    {
      "id": "output-publication",
      "contract": "A durable completed result is independent from response delivery. Closure or a late send suppresses publication without erasing completion, redelivery or releasing occupied quota early."
    }
  ],
