      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "AgentCardRegistry and ISageRegistry getAgent inputs share names/types but output tuples differ. Neither exported tuple is the closed normative record; a reviewed exact ABI/record mapping is required."
    },
    {
      "id": "named-key-lifecycle",
      "normative_rules": [
        "REG-01",
        "REG-02",
        "REG-03"
      ],
      "source_spans": [
        "key-storage",
        "key-revocation"
      ],
      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "Stored keys have numeric keyType, bytes, signature, verified and registeredAt. A hash-indexed verified flag cannot supply named immutable entries, retained tombstones, proof signer identity or approved role mapping on its own. Optional expiry absence is not itself a violation."
    },
    {
      "id": "record-version",
      "normative_rules": [
        "REG-03",
        "REG-05"
      ],
      "source_spans": [
        "key-addition",
        "key-revocation",
        "metadata-version-counter",
        "kem-version-counter",
        "endpoint-version-counter"
      ],
      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "agentNonce increments on metadata/KEM/endpoint updates but not all lifecycle/key mutations; mutation APIs do not take the normative expected previous record version. It cannot be assumed to be the whole-record version."
    },
    {
      "id": "terminal-state",
      "normative_rules": [
        "REG-03"
      ],
      "source_spans": [
        "activation-state",
        "deactivation-state"
      ],
      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "A single active boolean is used for initial inactivity and deactivation; a reviewed mapping must establish created/active/terminal deactivated state and authenticated transitions, not infer them from the boolean alone."
    },
    {
      "id": "proof-validation",
      "normative_rules": [
        "REG-04",
        "REG-06"
      ],
      "source_spans": [
        "ed25519-validation",
        "kem-legacy-endorsement"
      ],
      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "The reviewed Ed25519 branch checks signature length only. X25519 uses a separate wallet-domain endorsement. Neither verified=true nor these legacy domains establish the normative named-key challenge/proof; complete independent proof validation is required."
    },
    {
      "id": "claim-and-identity",
      "normative_rules": [
        "REG-06"
      ],
      "source_spans": [
        "legacy-claim",
        "registry-did-hook"
      ],
      "status": "MAPPING_REVIEW_REQUIRED",
      "review": "The candidate uses a keccak/ABI commitment with timestamp windows and a legacy DID hook. The normative profile specifies SHA-256/domain/JCS claim bytes, block windows and canonical locator/agent identity. A reader alone cannot establish write-side compliance."
    },
    {
      "id": "actual-provider-ownership",
      "normative_rules": [
