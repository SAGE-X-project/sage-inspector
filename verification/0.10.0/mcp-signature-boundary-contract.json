  "kind": "mcp-signature-boundary-contract",
  "conformance": "NOT_ESTABLISHED",
  "boundaries": [
    {
      "id": "intent-algorithm",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1"
      ],
      "contract": "A valid role-bound Ed25519 intent proof continues authority, policy and durable reservation validation. Valid P-256 and secp256k1 proofs are rejected before trusted-service calls or storage mutation."
    },
    {
      "id": "result-algorithm",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1"
      ],
      "contract": "A valid correlated Ed25519 result proof continues authority and outstanding-intent validation. Valid P-256 and secp256k1 result proofs are rejected before trusted-service calls, intent lookup or authenticated output release."
    }
  ],
