{
  "schema_version": 1,
  "protocol_version": "0.10.0",
  "kind": "mcp-signature-boundary-contract",
  "conformance": "NOT_ESTABLISHED",
  "boundaries": [
    {
      "id": "intent-algorithm",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1"
      ],
      "contract": "A valid role-bound Ed25519 intent proof continues authority, policy and durable reservation validation. Valid P-256 and secp256k1 proofs are rejected before trusted-service calls or storage mutation."
    },
    {
      "id": "result-algorithm",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1"
      ],
      "contract": "A valid correlated Ed25519 result proof continues authority and outstanding-intent validation. Valid P-256 and secp256k1 result proofs are rejected before trusted-service calls, intent lookup or authenticated output release."
    },
    {
      "id": "carriage-algorithm",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1",
        "x25519"
      ],
      "contract": "Outer and handshake signatures continue only with exact active Ed25519 keys bound to the initiator and responder roles. P-256, secp256k1 and X25519 cannot occupy either signing role, while the responder X25519 KEM selection remains independent."
    },
    {
      "id": "signing-key-availability",
      "accepted": "ed25519",
      "rejected": [
        "ecdsa-p256-sha256",
        "secp256k1",
        "x25519"
      ],
      "contract": "If either participant lacks the exact requested active Ed25519 signing key, binding is unsupported. Another active signing key, another algorithm and the X25519 KEM cannot be substituted or tried as fallback."
    }
  ],
  "cores": {
